  m_Script: {fileID: 11500000, guid: ab16c4c9be9f4134e9e1280441fa2bbc, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MunicipalRecord
  interactionName: Contractor Job Ledger
  isInformationSource: 0
  npcProfile: 0
  openingLine: It's been a quiet day around here.
  choice1: Ask about Daniel
  response1: Daniel Mercer disappeared seven years ago.
  choice2: Ask about the town
  response2: Nothing much changes around here.
  informationID: anonymous_package
  informationTitle: Anonymous package
  informationSource: Anonymous package
  informationDescription: An anonymous sender sent me two waterworks records and a note claiming the original search missed something.
  informationType: 2
  isSceneExit: 0
  destinationScene: Diner_Investigation
  destinationSpawnID: 
  requiredInformationID: municipal_retention_index
  unavailableMessage: The contractor's job register contains years of entries. The municipal records should help identify the relevant work order.
  department: GRAYFORD MUNICIPAL RECORDS
  documentTitle: Contractor Job Ledger
  reference: WW-91-184
  documentDate: 08 OCT 1991
  documentBody: "BELL MUNICIPAL SERVICES\r\nCONTRACTOR JOB REGISTER \u2014 OCTOBER 1991\r\n\r\nJob Reference: WW-91-184\r\nClient: Grayford Public Works\r\nLocation: North County Waterworks\r\nDate Opened: October 8, 1991\r\n\r\nRequested Work:\r\nInspect drainage conditions near lower service access. Assess possible clearance and sealing requirements.\r\n\r\nPersonnel Assigned:\r\nField crew \u2014 two workers\r\nSupervisor \u2014 F. Bell\r\n\r\nStatus:\r\nJob opened and personnel assigned.\r\n\r\nFinal inspection or completion confirmation not included in this register."
  evidenceID: bell_job_ledger
  evidenceTitle: Contractor Job Ledger
  journalNote: Bell Municipal Services opened job WW-91-184 on October 8, 1991, and assigned a two-person field crew under Frank Bell's supervision. The register does not confirm completion.
  evidenceSource: Bell Municipal Services
