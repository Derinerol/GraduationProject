  m_Script: {fileID: 11500000, guid: ab16c4c9be9f4134e9e1280441fa2bbc, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MunicipalRecord
  interactionName: Personnel Assignment Register
  isInformationSource: 0
  npcProfile: 0
  openingLine: It's been a quiet day around here.
  choice1: Ask about Daniel
  response1: Daniel Mercer disappeared seven years ago.
  choice2: Ask about the town
  response2: Nothing much changes around here.
  informationID: anonymous_package
  informationTitle: Anonymous package
  informationSource: Anonymous package
  informationDescription: An anonymous sender sent me two waterworks records and a note claiming the original search missed something.
  informationType: 2
  isSceneExit: 0
  destinationScene: Diner_Investigation
  destinationSpawnID: 
  requiredInformationID: bell_dispatch_sheet
  unavailableMessage: The personnel assignments are filed by job reference. I should examine the equipment dispatch records before trying to identify the workers assigned to this job.
  department: GRAYFORD MUNICIPAL RECORDS
  documentTitle: Personnel Assignment Register
  reference: WW-91-184
  documentDate: 09 OCT 1991
  documentBody: "BELL MUNICIPAL SERVICES\r\nPERSONNEL ASSIGNMENT REGISTER \u2014 OCTOBER 1991\r\n\r\nJob Reference: WW-91-184\r\nDate: October 9, 1991\r\nClient: Grayford Public Works\r\nLocation: North County Waterworks\r\n\r\nASSIGNED PERSONNEL\r\n\r\nSupervisor:\r\nF. Bell\r\n\r\nField Worker 01:\r\nCaleb Turner\r\n\r\nField Worker 02:\r\nR. Hayes\r\n\r\nASSIGNMENT DETAILS\r\n\r\nTask:\r\nLower-access drainage inspection and assessment.\r\n\r\nAssigned Vehicle:\r\nUtility Truck 02\r\n\r\nEquipment:\r\nPortable drainage pump, inspection lamps, and general maintenance tools.\r\n\r\nAssignment Authorized By:\r\nF. Bell\r\n\r\nADMINISTRATIVE NOTES\r\n\r\nPersonnel assigned to the job as listed above.\r\n\r\nIndividual attendance confirmations: Not attached.\r\nField statements: Not attached.\r\nWork completion status: Not indicated.\r\n\r\nThis register documents personnel assignments only. It does not establish whether the listed workers attended the site or completed the assigned work.\n"
  evidenceID: bell_personnel_register
  evidenceTitle: Personnel Assignment Register
  journalNote: Bell's personnel register identifies Caleb Turner and R. Hayes as the two workers assigned to WW-91-184 on October 9, 1991. It does not confirm their presence at the site.
  evidenceSource: Bell Municipal Services
