  selectedEntryColor: {r: 0.39, g: 0.47, b: 0.52, a: 1}
  hypothesisDefinitions:
  - hypothesisID: unresolved_waterworks_work
    informationEntryID: hypothesis_unresolved_waterworks_work
    title: Unresolved Waterworks Work
    description: The town log and Bell's work order refer to the same job, but neither establishes whether the proposed access work was completed.
    requiredInformationID1: maintenance_record_copy
    requiredInformationID2: work_order_fragment
  - hypothesisID: unverified_departure
    informationEntryID: hypothesis_unverified_departure
    title: An Unverified Departure
    description: Evelyn accepted the departure explanation without witnessing it, and the Gazette's follow-up cited no witness to Daniel leaving. The published account appears to lack independent confirmation.
    requiredInformationID1: evelyn_accepted_account
    requiredInformationID2: gazette_followup_report
  - hypothesisID: billed_work_unverified
    informationEntryID: hypothesis_unverified_departure
    title: Work Billed, Completion Unverified
    description: Bell billed the town for work associated with WW-91-184, but the available municipal ledger does not confirm that the work was completed. The records leave the relationship between billing and actual site work unresolved.
    requiredInformationID1: municipal_status_ledger
    requiredInformationID2: bell_billing_copy
