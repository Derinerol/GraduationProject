  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::NewspaperEvidence
  interactionName: Read October 1991 Gazette
  isInformationSource: 0
  npcProfile: 0
  openingLine: It's been a quiet day around here.
  choice1: Ask about Daniel
  response1: Daniel Mercer disappeared seven years ago.
  choice2: Ask about the town
  response2: Nothing much changes around here.
  informationID: anonymous_package
  informationTitle: Anonymous package
  informationSource: Anonymous package
  informationDescription: An anonymous sender sent me two waterworks records and a note claiming the original search missed something.
  informationType: 2
  isSceneExit: 0
  destinationScene: Diner_Investigation
  destinationSpawnID: 
  publication: THE GRAYFORD GAZETTE
  publicationDate: October 24, 1991
  headline: Search for Missing Resident Continues
  articleBody: "Grayford resident Daniel Mercer, 27, has been missing since October 17. Family members reported his disappearance after failing to reach him.\n\n      The sheriff's office confirmed that inquiries had been made into Mercer's whereabouts. Authorities said there was no indication of foul play and suggested he may have left town voluntarily.\n\n      No confirmed sighting of Mercer outside Grayford was reported at the time of publication.\n\n      Relatives have requested that anyone with information contact the sheriff's office."
  evidenceID: gazette_original_report
  evidenceTitle: Original Disappearance Report
  journalNote: The Gazette reported Daniel's disappearance and attributed the voluntary-departure explanation to the sheriff's office.
