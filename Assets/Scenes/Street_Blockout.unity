  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Interactable
  interactionName: Newspaper
  isInformationSource: 1
  openingLine: It's been a quiet day around here.
  choice1: Ask about the town.
  response1: "Nothing much happens\n around here."
  choice2: Ask about Daniel
  response2: I remember Daniel. The official story was that he left voluntarily, but some people here never believed it.
  followUpChoice: Ask why the original account was accepted
  followUpResponse: At the time, people accepted the explanation. There wasn't much reason to question it.
  informationID: daniel_newspaper
  informationTitle: Daniel's Disappearance
  informationSource: Newspaper clipping
  informationDescription: An old newspaper clipping dated seven years ago reports that Daniel disappeared.
  informationType: 0
