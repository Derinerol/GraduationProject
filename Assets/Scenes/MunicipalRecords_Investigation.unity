  m_Script: {fileID: 11500000, guid: ab16c4c9be9f4134e9e1280441fa2bbc, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MunicipalRecord
  interactionName: Resident
  isInformationSource: 1
  npcProfile: 0
  openingLine: It's been a quiet day around here.
  choice1: Ask about Daniel
  response1: Daniel Mercer disappeared seven years ago.
  choice2: Ask about the town
  response2: Nothing much changes around here.
  informationID: municipal_facilities_alteration_register
  informationTitle: Anonymous package
  informationSource: Anonymous package
  informationDescription: An anonymous sender sent me two waterworks records and a note claiming the original search missed something.
  informationType: 2
  isSceneExit: 0
  destinationScene: Diner_Investigation
  destinationSpawnID: 
  requiredInformationID: helen_facilities_register_lead
  unavailableMessage: This register is kept separately from the maintenance files. Helen may know where to find it.
  department: "Grayford Public Works \u2014 Facilities Division"
  documentTitle: Facilities Alteration Register
  reference: FAR-90-93 / Entry 184-A
  documentDate: February 18, 1992
  documentBody: "GRAYFORD PUBLIC WORKS\r\nFACILITIES ALTERATION REGISTER\r\nExtract: January 1990 \u2013 December 1993\r\n\r\nENTRY 041 \u2014 MARCH 12, 1990\r\nFacility: Municipal Garage\r\nWork: Replacement of exterior access doors\r\nAuthorization: PW-90-041\r\nStatus: Closed\r\nCompletion documentation: Filed\r\n\r\nENTRY 116 \u2014 JUNE 4, 1991\r\nFacility: North County Waterworks\r\nWork: Upper pump housing ventilation modifications\r\nAuthorization: PW-91-116\r\nStatus: Closed\r\nCompletion documentation: Filed\r\n\r\nENTRY 184-A \u2014 OCTOBER 1991\r\nFacility: North County Waterworks\r\nArea: Lower service access\r\nWork: Access / barrier arrangement\r\nAssociated reference: WW-91-184\r\nAuthorization: Not entered\r\nContractor: Not entered\r\nCompletion date: Not entered\r\nStatus: Unconfirmed\r\n\r\nENTRY 022 \u2014 FEBRUARY 18, 1992\r\nFacility: Municipal Storage Annex\r\nWork: Internal partition installation\r\nAuthorization: PW-92-022\r\nStatus: Closed\r\nCompletion documentation: Filed\r\n\r\nCLERK'S NOTE:\r\nEntry 184-A refers to associated maintenance documentation not included with this register extract. No installation specification or completion confirmation is attached."
  evidenceID: municipal_facilities_alteration_register
  evidenceTitle: Facilities Alteration Register
  journalNote: An October 1991 entry links the lower waterworks access to WW-91-184, but leaves authorization, contractor, and completion blank.
  evidenceSource: Grayford Public Works
