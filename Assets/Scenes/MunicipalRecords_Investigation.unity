  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MunicipalRecord
  interactionName: Resident
  isInformationSource: 1
  npcProfile: 0
  openingLine: It's been a quiet day around here.
  choice1: Ask about Daniel
  response1: Daniel Mercer disappeared seven years ago.
  choice2: Ask about the town
  response2: Nothing much changes around here.
  informationID: municipal_maintenance_register
  informationTitle: Anonymous package
  informationSource: Anonymous package
  informationDescription: An anonymous sender sent me two waterworks records and a note claiming the original search missed something.
  informationType: 2
  isSceneExit: 0
  destinationScene: Diner_Investigation
  destinationSpawnID: 
  requiredInformationID: maintenance_record_copy
  unavailableMessage: The register is indexed by reference number. The copied work order may help locate the original.
  department: GRAYFORD MUNICIPAL RECORDS
  documentTitle: Maintenance Register
  reference: WW-91-184
  documentDate: 08 OCT 1991
  documentBody: "NORTH COUNTY WATERWORKS\r\nMAINTENANCE REGISTER \u2014 OCTOBER 1991\r\n\r\nReference: WW-91-184\r\nDate Entered: October 8, 1991\r\nLocation: Lower Service Access\r\nAuthorized By: T. Reed\r\n\r\nDrainage inspection requested following reports of standing water near the lower service access.\r\n\r\nContractor work authorization referenced under WW-91-184.\r\n\r\nNo completion status recorded in this register."
  evidenceID: municipal_maintenance_register
  evidenceTitle: Municipal Maintenance Register
  journalNote: WW-91-184 was entered on October 8, 1991, for drainage inspection near the lower waterworks access.
  evidenceSource: Grayford Municipal Records Office
